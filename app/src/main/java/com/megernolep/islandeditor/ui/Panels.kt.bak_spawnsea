    CheckRow("Mode hapus", o.thornErase) { v -> vm.setOpts { it.copy(thornErase = v) } }
    CheckRow("Hanya di darat (lewati air)", o.thornLand) { v -> vm.setOpts { it.copy(thornLand = v) } }
    Note("Terpasang: ${vm.doc.thorns.size} tile", TextHi)
